# انسخ هذا الملف إلى .env وعبّي القيم. لا ترفع .env على GitHub أبداً.

# توكن البوت (Developer Portal > Bot > Reset Token)
TOKEN=
# ايدي التطبيق و السيكرت (Developer Portal > OAuth2) — مطلوبين لتسجيل الدخول بـ Discord
CLIENT_ID=
CLIENT_SECRET=
# ايدي حسابك أنت (المالك). تقدر تحط أكثر من مالك مفصولين بفاصلة: 111111111111111111,222222222222222222
# يفعّل لوحة المالك ونظام الاشتراكات. اتركه فاضي = بدون اشتراكات
OWNER_ID=

# المنفذ المحلي للويب
# PORT=3000
# الرابط العام للوحة (لازم https في الإنتاج). على Render اتركه فاضي (يُؤخذ تلقائياً من RENDER_EXTERNAL_URL).
# يُسجَّل في Developer Portal > OAuth2 > Redirects كـ: <الرابط>/auth/callback
# PUBLIC_URL=http://localhost:3000

# مجلد حفظ البيانات (اختياري، الافتراضي ./data)
# DATA_DIR=./data
